{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/((?!callback).*)",
      "missing": [
        {
          "type": "header",
          "key": "x-gateway-secret",
          "value": "cf-gateway-verified-sec-883a9f"
        }
      ],
      "destination": "https://www.mathhub.pro/about/ai-trader",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ai-trader-backend.onrender.com/api/$1"
    },
    {
      "source": "/ws",
      "destination": "wss://ai-trader-backend.onrender.com/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
